worker_processes 1;
# Each connection can hold two descriptors (client and upstream): at least twice worker_connections.
worker_rlimit_nofile 2048;
daemon off;
error_log /var/logs/nginx/error.log;
pid /tmp/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    passenger_root REPLACE_ME_PASSENGER_ROOT;
    passenger_ruby /usr/local/bin/ruby;

    # Store passenger logs centrally
    passenger_log_file /var/logs/passenger/passenger.log;
    passenger_instance_registry_dir /tmp/passenger;
    # The default (<nginx prefix>/passenger_temp) is not writable by the unprivileged account.
    passenger_temp_path /tmp/nginx/passenger_temp;
    # The image ships no CA certificates and has no business calling home: Passenger's daily security
    # update check (which failed with an SSL error) and its anonymous telemetry are off. Vulnerabilities
    # are tracked by the Trivy and Grype gates of CI instead.
    passenger_disable_security_update_check on;
    passenger_disable_anonymous_telemetry on;

    include /opt/nginx/conf/mime.types;
    access_log /var/logs/nginx/access.log;
    # Do not disclose the nginx version in the Server header and on error pages.
    server_tokens off;

    client_body_temp_path /tmp/nginx/client_body;
    fastcgi_temp_path /tmp/nginx/fastcgi_temp;
    proxy_temp_path /tmp/nginx/proxy_temp;
    scgi_temp_path /tmp/nginx/scgi_temp;
    uwsgi_temp_path /tmp/nginx/uwsgi_temp;

    server {
        listen 80;
        server_name localhost;
        root /app/public;

        passenger_enabled on;
        passenger_app_env production;

        location /health {
            passenger_enabled on;
            # Disable access log for health endpoint to save IO operations
            access_log off;
        }
    }
}
