# typed: false
# frozen_string_literal: true

require_relative 'config/application'

Rails.application.load_tasks

# The repository root: the shell gates and the outdated check cover the whole repository, not only the app.
REPOSITORY_ROOT = File.expand_path('..', __dir__)

# Flay mass threshold. At the default (16) Flay only reports identical Sorbet `sig` declarations of sibling
# methods; from 24 up it reports every duplicated piece of logic.
FLAY_MASS = 24

# Output of `yard stats` when every public API object is documented.
FULLY_DOCUMENTED = '100.00% documented'

# Rails defines `spec` (rspec-rails) as the task that runs the suite; SimpleCov fails it below 100% line
# and branch coverage, and spec/spec_helper.rb fails it on any warning, pending or skipped example.

desc 'Run RuboCop'
task :rubocop do
  sh 'bundle exec rubocop'
end

desc 'Fail on inline suppressions of any linter, scanner, type checker, warning or test'
task :suppressions do
  sh File.join(REPOSITORY_ROOT, 'script', 'forbidden_suppressions.sh')
end

desc 'Generate the gem and DSL RBIs with Tapioca, then run the Sorbet type checker'
task :typecheck do
  sh 'bundle exec tapioca gem --quiet'
  sh 'bundle exec tapioca dsl --quiet'
  sh 'bundle exec srb tc'
end

desc 'Fail unless every public API object is documented'
task :yard do
  output = IO.popen(%w[bundle exec yard stats --list-undoc], err: %i[child out], &:read)
  puts output
  abort 'YARD: undocumented API objects found' if output.exclude?(FULLY_DOCUMENTED)
end

desc 'Fail on any code smell (default Reek configuration, no exclusions)'
task :reek do
  sh 'bundle exec reek app lib'
end

desc 'Fail on any structural duplication'
task :flay do
  output = IO.popen(['bundle', 'exec', 'flay', '--mass', FLAY_MASS.to_s, 'app', 'lib'], &:read)
  puts output
  abort 'Flay: duplicated code found' unless output.start_with?('Total score (lower is better) = 0')
end

desc 'Fail on any Brakeman warning (security static analysis)'
task :brakeman do
  sh 'bundle exec brakeman --quiet --no-pager --no-summary --ensure-latest --ensure-ignore-notes --run-all-checks'
end

desc 'Audit gem dependencies for known vulnerabilities'
task :audit do
  sh 'bundle exec bundler-audit check --update'
end

desc 'Fail on outdated dependencies that are not on the documented hold list (script/outdated_holds.yml)'
task :outdated do
  ruby File.join(REPOSITORY_ROOT, 'script', 'outdated.rb')
end

desc 'Run mutation testing (see .mutant.yml); every mutation must be killed'
task :mutant do
  sh 'bundle exec mutant run'
end

Rake::Task[:default].clear if Rake::Task.task_defined?(:default)
task default: %i[spec rubocop suppressions typecheck yard reek flay brakeman audit]
