require_relative 'config/application'
require_relative 'lib/tasks/quality_gates'
require 'active_support/core_ext/string/exclude'

Rails.application.load_tasks

# The tasks of the quality gates (their commands and helpers: lib/tasks/quality_gates.rb). Each task shells out to
# its tool, which loads what it needs itself; only `debride` boots the application (it reads the routes). Rails
# defines `spec` (rspec-rails), the suite that SimpleCov fails below 100% line, branch and method coverage and
# spec/spec_helper.rb fails on any warning, pending or skipped example.
module QualityGateTasks
  extend Rake::DSL
  extend T::Sig
  include QualityGates

  # Runs +command+, prints its output, and returns that output; aborts with +failure+ when it exits non-zero.
  # @param command [Array<String>]
  # @param failure [String]
  # @param directory [String] the working directory of the command
  # @return [String]
  sig { params(command: T::Array[String], failure: String, directory: String).returns(String) }
  def self.capture(command, failure, directory: Dir.pwd)
    output, status = QualityGates.run(command, directory:)
    puts(output)
    abort(failure) unless status&.success?
    output
  end

  # Loads the Ruby script +name+ of script/, runs it (the block) and aborts when it fails.
  # @param name [String]
  # @yieldreturn [Integer] the exit status of the script
  sig { params(name: String, block: T.proc.returns(Integer)).void }
  def self.script(name, &block)
    require(File.join(SCRIPTS, name))
    abort("script/#{name}.rb failed") if yield.nonzero?
  end

  desc 'Run RuboCop (the application and the repository scripts)'
  task :rubocop do
    sh 'bundle exec rubocop'
    sh "bundle exec rubocop --config .rubocop.yml #{SCRIPTS}"
  end

  desc 'Fail on inline suppressions of any linter, scanner, type checker, warning or test'
  task :suppressions do
    sh File.join(REPOSITORY_ROOT, 'script', 'forbidden_suppressions.sh')
  end

  desc 'Generate the gem and DSL RBIs with Tapioca, then run the Sorbet type checker'
  task :typecheck do
    sh 'bundle exec tapioca gem'
    sh 'bundle exec tapioca dsl'
    sh 'bundle exec srb tc'
  end

  desc 'Fail unless every object, private and protected ones included, is documented (application and scripts), ' \
    'without a YARD warning'
  task :yard do
    # The application reads .yardopts; YARD cannot be pointed at files outside its working directory, so the
    # scripts are documented from their own directory with the same options.
    script_files = %w[--private --protected --markup markdown outdated.rb outdated/**/*.rb scorecards.rb]
    { Dir.pwd => [], SCRIPTS => script_files }.each do |directory, files|
      capture(
        [*Programs::RUBY, Programs::YARD, '--', 'doc', '--fail-on-warning', '--no-output', '--no-save', *files],
        "YARD: warnings in #{directory}",
        directory:
      )
      output = capture(
        [*Programs::RUBY, Programs::YARD, '--', 'stats', '--list-undoc', '--no-save', *files],
        "YARD failed in #{directory}",
        directory:
      )
      abort "YARD: undocumented objects found in #{directory}" if output.exclude?(FULLY_DOCUMENTED)
      abort "YARD: warnings in #{directory}" if output.include?('[warn]')
    end
  end

  desc 'Fail on any code smell (default Reek configuration, no exclusions)'
  task :reek do
    capture(['bundle', 'exec', 'reek', *SOURCES], 'Reek: code smells found')
  end

  desc "Fail on any structural duplication (Flay's default mass)"
  task :flay do
    output = capture(['bundle', 'exec', 'flay', *SOURCES], 'Flay failed')
    abort 'Flay: duplicated code found' unless output.start_with?('Total score (lower is better) = 0')
  end

  desc "Fail on any method with a Flog score above #{Complexity::THRESHOLD}"
  task :flog do
    report = capture(['bundle', 'exec', 'flog', '--all', '--methods-only', *SOURCES], 'Flog failed')
    complex = Complexity.complex_methods(report)
    abort "Flog: methods scoring above #{Complexity::THRESHOLD}:\n#{complex.join("\n")}" unless complex.empty?
  end

  desc 'Fail on any method nothing calls (debride); the actions the routes dispatch to count as called'
  task debride: :environment do
    actions = Rails.application.routes.routes.filter_map { |route| route.defaults[:action] }
    QualityGates.with_file(actions) do |routed|
      output = capture(['bundle', 'exec', 'debride', '--rails', '--whitelist', routed, *SOURCES], 'debride failed')
      abort 'debride: methods without a caller found' if output.exclude?('Total suspect LOC: 0')
    end
  end

  desc 'Fail on any Brakeman warning (security static analysis)'
  task :brakeman do
    options = %w[--quiet --no-pager --no-summary --ensure-latest --ensure-ignore-notes --run-all-checks]
    capture([*Programs::RUBY, Programs::BRAKEMAN, '--', *options], 'Brakeman: warnings found')
  end

  desc 'Audit gem dependencies for known vulnerabilities'
  task :audit do
    sh 'bundle exec bundler-audit check --update'
  end

  desc 'Fail on outdated dependencies that are not on the documented hold list (script/outdated_holds.yml)'
  task :outdated do
    script('outdated') { Outdated.run }
  end

  desc 'Fail when the pull request adds a dependency below the OpenSSF Scorecard threshold (script/scorecards.rb)'
  task :scorecards do
    script('scorecards') { Scorecards.run }
  end

  desc 'Run mutation testing (see .mutant.yml); every mutation must be killed'
  task :mutant do
    sh 'bundle exec mutant run'
  end

  Rake::Task[:default].clear if Rake::Task.task_defined?(:default)
  task default: %i[spec rubocop suppressions typecheck yard reek flay flog debride brakeman audit]
end
