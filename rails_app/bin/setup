#!/usr/bin/env ruby
# typed: strict
# frozen_string_literal: true

# Copyright (c) 2026 Vitalii Lazebnyi

# Sets up or updates the development environment. Idempotent: it can be run at any time.

root = File.expand_path('..', __dir__)

puts '== Installing dependencies =='
system('bundle check', chdir: root) || system('bundle install', chdir: root, exception: true)

puts "\n== Preparing database =="
system('bin/rails db:prepare', chdir: root, exception: true)
system('bin/rails db:reset', chdir: root, exception: true) if ARGV.include?('--reset')

puts "\n== Removing old logs and tempfiles =="
system('bin/rails log:clear tmp:clear', chdir: root, exception: true)

exit if ARGV.include?('--skip-server')

puts "\n== Starting development server =="
# The output is flushed before exec(2) replaces the process, so that it is displayed.
$stdout.flush
exec('bin/dev', chdir: root)
