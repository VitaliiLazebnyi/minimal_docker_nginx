# frozen_string_literal: true

source 'https://rubygems.org'

gem 'passenger', '~> 6.2'
# Only the frameworks config/application.rb loads, instead of the `rails` meta-gem (which also installs Action
# Cable, Action Mailer, Action Mailbox, Action Text, Active Job and Active Storage, none of which the API uses).
gem 'actionpack', '~> 8.1.4'
gem 'actionview', '~> 8.1.4'
gem 'activemodel', '~> 8.1.4'
gem 'activerecord', '~> 8.1.4'
gem 'activesupport', '~> 8.1.4'
gem 'railties', '~> 8.1.4'
# Runtime half of the Sorbet signatures in app/ (`extend T::Sig`, `sig { ... }`).
gem 'sorbet-runtime', '~> 0.6'
gem 'sqlite3', '~> 2.10'
# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

group :development do
  # `bin/dev` (rails server) for local development; production is served by Passenger.
  gem 'puma', '~> 8.0', require: false
end

group :development, :test do
  gem 'rspec-rails', '~> 8.0'
  gem 'simplecov', '~> 1.3', require: false

  # Quality tooling: linting, typing, documentation, smells, mutation testing, security audits.
  gem 'brakeman', '~> 8.1', require: false
  gem 'bundler-audit', '~> 0.9', require: false
  gem 'flay', '~> 2.14', require: false
  gem 'mutant-rspec', '~> 0.17', require: false
  gem 'reek', '~> 6.6', require: false
  gem 'rubocop', '~> 1.92', require: false
  gem 'rubocop-md', '~> 2.0', require: false
  gem 'rubocop-performance', '~> 1.27', require: false
  gem 'rubocop-rails', '~> 2.38', require: false
  gem 'rubocop-rake', '~> 0.7', require: false
  gem 'rubocop-rspec', '~> 3.10', require: false
  gem 'rubocop-rspec_rails', '~> 2.33', require: false
  gem 'rubocop-sorbet', '~> 0.17', require: false
  gem 'rubocop-thread_safety', '~> 0.8', require: false
  gem 'sorbet', '~> 0.6', require: false
  gem 'tapioca', '~> 0.20', require: false
  gem 'yard', '~> 0.9', require: false
  gem 'yard-sorbet', '~> 0.9', require: false
end
