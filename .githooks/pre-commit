#!/usr/bin/env bash
# Pre-commit hook: the fast gates (suppressions, RSpec, RuboCop, Sorbet), plus the linters that are installed.
# Install: git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "${root}"

echo "==> Checking for inline suppressions..."
script/forbidden_suppressions.sh

echo "==> Running RSpec, RuboCop and Sorbet..."
(cd rails_app && bundle exec rake spec rubocop typecheck)

# Installed with `pip install --require-hashes -r tools/requirements.txt` (see CONTRIBUTING.md).
for tool in shellcheck typos actionlint; do
  if ! command -v "${tool}" > /dev/null; then
    echo "==> ${tool} is not installed; CI runs it"
    continue
  fi
  echo "==> Running ${tool}..."
  case "${tool}" in
    shellcheck) shellcheck script/*.sh test/image/*.sh docker_config/entrypoint.sh .githooks/pre-commit ;;
    *) "${tool}" ;;
  esac
done

echo "==> All checks passed."
