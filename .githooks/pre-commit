#!/usr/bin/env bash
# Pre-commit hook: the fast checks of script/check (suppressions, RSpec, RuboCop, Sorbet), plus the linters that are
# installed. CI runs every check. Install: git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "${root}"

script/check suppressions spec rubocop typecheck

# Installed from tools/requirements.txt and tools/binaries.json (see CONTRIBUTING.md).
declare -A tools=(
  [actionlint]=actionlint [shellcheck]=shellcheck [shfmt]=shfmt [typos]=typos [rumdl]=rumdl [yamllint]=yamllint
  [editorconfig]=editorconfig-checker
)
for check in actionlint shellcheck shfmt typos rumdl yamllint editorconfig; do
  if command -v "${tools[${check}]}" >/dev/null; then
    script/check "${check}"
  else
    echo "==> ${check}: ${tools[${check}]} is not installed; CI runs it"
  fi
done

echo "==> All checks passed."
